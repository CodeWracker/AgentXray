#!/usr/bin/env bash
# Interpretador da bancada: ambiente travado pelo uv.lock, sem rede para modelos, caches fixos.
# Uso: bench/tools/py script.py [args...]   (funciona a partir de qualquer diretório)
set -euo pipefail
BENCH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_HUB_CACHE="$HOME/.cache/xray-bench/hub"
export YOLO_OFFLINE=1
export YOLO_CONFIG_DIR="$HOME/.cache/xray-bench/ultralytics"
export XRAY_BENCH_MODELS="$HOME/.cache/xray-bench"
export PYTHONHASHSEED=0
export CUBLAS_WORKSPACE_CONFIG=:4096:8
exec uv run --quiet --project "$BENCH" python "$@"
